<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EEF2FF"
    tools:context=".ProfileActivity">

    <!-- Header biru -->    
    <View
        android:id="@+id/profileHeader"
        android:layout_width="0dp"
        android:layout_height="240dp"
        android:background="#4361EE"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Teks Halaman Utama -->
    <TextView
        android:id="@+id/tvPageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="Halaman Utama"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Foto Profil (di atas card, overlapping) -->
    <ImageView
        android:id="@+id/imgProfile"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:src="@drawable/profile_photo"
        android:scaleType="centerCrop"
        android:background="@drawable/circle_border"
        android:padding="4dp"
        android:clipToOutline="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPageTitle"
        android:layout_marginTop="20dp" />

    <!-- Card Profil -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardProfile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="-50dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profileHeader">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="90dp"
            android:paddingBottom="36dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:gravity="center">

            <!-- Nama -->
            <TextView
                android:id="@+id/tvNama"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Khansa"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_marginBottom="8dp" />

            <!-- Username -->
            <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@khansa067"
                android:textSize="15sp"
                android:textColor="#4361EE"
                android:layout_marginBottom="16dp" />

            <!-- Garis pemisah -->
            <View
                android:layout_width="60dp"
                android:layout_height="3dp"
                android:background="#4361EE"
                android:layout_marginBottom="16dp" />

            <!-- Info tambahan -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengembangan Aplikasi Mobile"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semester 5"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginBottom="32dp" />

            <!-- Tombol Keluar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:text="Keluar"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#4361EE"
                app:backgroundTint="#EEF2FF"
                app:strokeColor="#4361EE"
                app:strokeWidth="2dp"
                app:cornerRadius="12dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
